# Port the API listens on
PORT=4000

# Comma-separated list of origins allowed to call this API from a browser.
# For the local frontend dev server:
CORS_ORIGIN=http://localhost:3000

# Path to the SQLite database file (created automatically on first run)
DATABASE_PATH=./data/leaderboard.sqlite3

# Max score submissions allowed per IP per minute (basic abuse protection)
RATE_LIMIT_PER_MINUTE=30
